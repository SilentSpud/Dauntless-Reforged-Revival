{
  "name": "dauntless-reforged-revival-launcher",
  "productName": "Dauntless Reforged Revival Launcher",
  "version": "1.5.1",
  "description": "Windows launcher for Dauntless Reforged Revival: join community servers from an invite, check your Dauntless 1.14.7 install, install the host's game runtime and play on a private server.",
  "main": ".vite/build/main.js",
  "private": true,
  "homepage": "https://github.com/FreezaMotoqueiro/Dauntless-Reforged-Revival",
  "repository": {
    "type": "git",
    "url": "https://github.com/FreezaMotoqueiro/Dauntless-Reforged-Revival.git",
    "directory": "legacy/ReforgedLauncher"
  },
  "bugs": {
    "url": "https://github.com/FreezaMotoqueiro/Dauntless-Reforged-Revival/issues"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package --platform win32",
    "make": "electron-forge make --platform win32",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "preview": "node scripts/preview.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "keywords": [
    "dauntless",
    "launcher",
    "private-server"
  ],
  "author": {
    "name": "Dauntless Reforged Revival contributors",
    "url": "https://github.com/FreezaMotoqueiro/Dauntless-Reforged-Revival"
  },
  "contributors": [
    {
      "name": "mixutin and the Dauntless Revived contributors, authors of the launcher this one is a modified version of",
      "url": "https://github.com/mixutin/dauntless-revived"
    },
    {
      "name": "Gregory Morford (gwog), author of the upstream Undaunted launcher",
      "url": "https://github.com/SyST3MDeV/Undaunted"
    }
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "electron": "44.4.3",
    "node-forge": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.3.0"
  },
  "overrides": {
    "extract-zip": "npm:@electron-internal/extract-zip@^1.0.1",
    "tar": "^7.5.22",
    "tmp": "^0.2.7"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  }
}
