{
  "name": "dauntless-reforged-revival-host",
  "version": "0.1.0",
  "description": "Host kit for Dauntless Reforged Revival: sets up Mystic Paradox with the Reforged patches, writes the server configuration, runs the services and makes invites",
  "license": "AGPL-3.0-only",
  "author": "Dauntless Reforged Revival contributors",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "precli": "npm run build --silent",
    "cli": "node dist/cli.js",
    "presetup": "npm run build --silent",
    "setup": "node dist/cli.js setup",
    "prestart": "npm run build --silent",
    "start": "node dist/cli.js start",
    "preinvite": "npm run build --silent",
    "invite": "node dist/cli.js invite",
    "predoctor": "npm run build --silent",
    "doctor": "node dist/cli.js doctor",
    "pregamedata": "npm run build --silent",
    "gamedata": "node dist/cli.js gamedata",
    "prepublish-runtime": "npm run build --silent",
    "publish-runtime": "node dist/cli.js publish-runtime",
    "prepreset": "npm run build --silent",
    "preset": "node dist/cli.js preset",
    "premultipliers": "npm run build --silent",
    "multipliers": "node dist/cli.js multipliers",
    "preupstream": "npm run build --silent",
    "upstream": "node dist/cli.js upstream",
    "preupdate": "npm run build --silent",
    "update": "node dist/cli.js update",
    "test": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"build/ReforgedHost/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "typescript": "6.0.3"
  }
}
