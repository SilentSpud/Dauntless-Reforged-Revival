# Dauntless Reforged Revival content server settings (npm start reads .env in this folder if it
# exists; variables already set in your shell win over it). ReforgedHost's `npm run setup` writes
# the real file for a server (.workspace/config/content.env); this one is for development.

# Listen port and address. Loopback only: players reach this server through the gateway.
# PORT=61002
# BIND_HOST=127.0.0.1
# Where account keys are checked (GET /reforged/api/GetUserInfo), on this machine.
# BACKEND_URL=http://127.0.0.1:61000

# The published game runtime: MysticParadox.dll, winmm.dll and runtime.json, written by
# ReforgedHost's `npm run publish-runtime` (or the launcher's Host page). Without it the launcher
# tells players that the host has not published a runtime yet.
CONTENT_RUNTIME_DIR=../.workspace/runtime

# Optional: the host's art pack (a folder of .jpg/.png/.webp, with an optional branding.json) and
# news (a JSON file). CONTENT_NEWS_URL can name a raw.githubusercontent.com file instead.
# CONTENT_BRANDING_DIR=
# CONTENT_NEWS_FILE=
# CONTENT_NEWS_URL=

# Downloads at once per account and in total, and how long a good key is trusted (seconds).
# CONTENT_MAX_STREAMS_PER_ACCOUNT=4
# CONTENT_MAX_STREAMS_TOTAL=48
# CONTENT_AUTH_CACHE_SECONDS=300

# debug, info, warn or error.
# LOG_LEVEL=info
