# Settings for compose.yaml (docs/hosting-docker.md): copy to .env and edit. Server settings themselves (mode,
# address, name, hunts, multipliers ...) are setup's: docker compose run --rm host setup ...

# public: also run the allowlist helper (a public server needs it). Leave empty for a private server.
COMPOSE_PROFILES=public
# A private server: the Tailscale network namespace (compose.tailscale.yaml); ; instead of : on Windows
#COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
#TS_AUTHKEY=tskey-auth-...

# Your Dauntless 1.14.7 folder (the one with Archon), mounted at /game: the game servers run from it
REFORGED_GAME_DIR=./game
# Files for the host kit's commands, mounted read-only at /import (the runtime's DLLs, game data packs)
REFORGED_IMPORT_DIR=./import

# Public server: the gateway's port as setup has it (443, or what you gave --public-port) ...
REFORGED_GATEWAY_PORT=443
# ... and where the host publishes it ([address:]port; the invites name setup's port, so keep them the same)
REFORGED_GATEWAY_PUBLISH=443
# The game servers' UDP ports: 8770-8777 up to 6 hunts, 8766-8777 for 10 (setup --max-hunts)
REFORGED_GAME_PORTS=8770-8777
REFORGED_GAME_PUBLISH_ADDRESS=0.0.0.0

# The commit the backend names to players (the AGPL source offer), baked in at build time:
#REFORGED_COMMIT=  (git rev-parse --short=12 HEAD)
# Image names, for a registry: <REFORGED_IMAGE>-front:<REFORGED_TAG> and <REFORGED_IMAGE>-server:<REFORGED_TAG>
#REFORGED_IMAGE=reforged-revival
#REFORGED_TAG=local
